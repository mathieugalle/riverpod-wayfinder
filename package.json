{
  "name": "riverpod-wayfinder",
  "displayName": "Riverpod Wayfinder",
  "publisher": "mathieugalle",
  "description": "Jump straight from a Riverpod provider usage (e.g. xxxProvider) to the hand-written class or function you actually wrote - not the generated .g.dart file. Handles files with multiple providers correctly.",
  "version": "0.2.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/mathieugalle/riverpod-wayfinder.git"
  },
  "bugs": {
    "url": "https://github.com/mathieugalle/riverpod-wayfinder/issues"
  },
  "homepage": "https://github.com/mathieugalle/riverpod-wayfinder#readme",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "riverpod",
    "flutter",
    "dart",
    "go to definition",
    "go to implementation",
    "navigation",
    "provider",
    "riverpod_generator",
    "code generation"
  ],
  "license": "MIT",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:dart"
  ],
  "contributes": {
    "commands": [
      {
        "command": "riverpod-wayfinder.goToDefinition",
        "title": "Riverpod Wayfinder: Go to Provider Source"
      }
    ],
    "keybindings": [
      {
        "command": "riverpod-wayfinder.goToDefinition",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "editorTextFocus && editorLangId == dart"
      }
    ],
    "configuration": {
      "title": "Riverpod Wayfinder",
      "properties": {
        "riverpod-wayfinder.enableLogging": {
          "type": "boolean",
          "default": false,
          "description": "Log each resolution decision (word matched, candidate .g.dart files, inferred symbol, target line) to the Debug Console for troubleshooting."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "tsc -p . --outDir out && node --test out/resolver.test.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.60.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "esbuild": "^0.25.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.2",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}
